# Salin ke .env dan sesuaikan. Lihat src/data_analytics/config.py.
# Di VPS pilot (docker-compose.yml): WAJIB ganti INTERNAL_API_TOKEN dan
# POSTGRES_PASSWORD dengan nilai rahasia asli — nilai di bawah ini hanya
# aman untuk dev lokal.

# Dipakai langsung oleh `uv run` di luar Docker (mis. alembic, ingest) —
# PostgreSQL + pgvector wajib (SQLite tidak didukung sejak fase 2). Nilai ini
# menunjuk analytics-db dari `make dev-up`. Di dalam docker-compose.yml,
# DATABASE_URL di-override memakai variabel POSTGRES_* di bawah.
DATABASE_URL=postgresql+psycopg://analytics:changeme-generate-a-real-secret@localhost:5432/analytics

# Kredensial database analytics-db (docker-compose.yml).
POSTGRES_USER=analytics
POSTGRES_PASSWORD=changeme-generate-a-real-secret
POSTGRES_DB=analytics

# Shared secret untuk endpoint internal (X-Internal-Token) — hanya dipanggil
# backend aplikasi utama lewat network Docker privat, tidak pernah publik.
INTERNAL_API_TOKEN=changeme-generate-a-real-secret

# Lihat riset UU PDP (.scratch/osn-data-analytics/issues/12-...): pengendali
# data wajib menetapkan & menegakkan periode retensinya sendiri.
DATA_RETENTION_MONTHS=24
